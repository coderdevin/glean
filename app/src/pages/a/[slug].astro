---
export const prerender = false;
import Site from "~/layouts/Site.astro";
import Lang from "~/components/Lang.astro";
import { localizedPath } from "~/lib/i18n";
import { db } from "~/db/client";
import { pickBySlug, adjacentPicks, adjacentAlbumPicks, albumById } from "~/lib/queries";
import { categoryBadge } from "~/lib/category";
import { formatDateISO, formatTimeHM, siteTz } from "~/lib/datetime";
import { renderMarkdown } from "~/lib/markdown";

const lang = Astro.locals.lang ?? "zh";
const L = (p: string): string => localizedPath(p, lang);

const slug = Astro.params.slug;
if (!slug) return new Response("Not found", { status: 404 });

const env = Astro.locals.runtime.env;
const pick = await pickBySlug(db(env.DB), slug);
if (!pick) return new Response("Not found", { status: 404 });

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=300, s-maxage=86400, stale-while-revalidate=86400",
);

const tz = siteTz(env);
const publishedDate = formatDateISO(pick.published_at, tz);
const publishedTime = formatTimeHM(pick.published_at, tz);

// Reading context: album members stay INSIDE their album (breadcrumb +
// prev/next by position_in_album); everything else uses the global daily
// timeline. Album picks carry a daily_date too (set at publish), so we must
// branch on album membership, not fall through to the daily path.
const album = pick.album_id ? await albumById(db(env.DB), pick.album_id) : null;
const { prev, next } = album
  ? await adjacentAlbumPicks(db(env.DB), {
      albumId: pick.album_id!,
      positionInAlbum: pick.position_in_album,
      id: pick.id,
    })
  : await adjacentPicks(db(env.DB), {
      dailyDate: pick.daily_date,
      positionInDay: pick.position_in_day,
    });
// Neighbor suffix after "上一条/下一条": in an album it's a fixed marker; on the
// daily timeline it's the neighbor's date ("· MM-DD") or "· 同日".
const neighborSuffixZh = (d: string) => (album ? "专辑" : d === pick.daily_date ? "同日" : d.slice(5));
const neighborSuffixEn = (d: string) => (album ? "in album" : d === pick.daily_date ? "same day" : d.slice(5));

/** Per-section count of editor annotations anchored to it. */
const annotationsByAnchor = new Map<string, number>();
for (const a of pick.annotations) {
  annotationsByAnchor.set(a.anchor, (annotationsByAnchor.get(a.anchor) ?? 0) + 1);
}

const tocItems = pick.sections.map((s, i) => {
  const anchorId = s.anchor_id ?? "";
  return {
    id: `row-${i + 1}`,
    section: `§ ${i + 1}`,
    labelZh: s.heading_zh,
    labelEn: s.heading_en,
    count: anchorId ? annotationsByAnchor.get(anchorId) ?? 0 : 0,
  };
});

/** Modebar labels flip when the source article is Chinese (e.g. an infoq.cn
 *  link). Default (en/other source) leaves "英文原文" / "中文译文" as-is. */
const sourceIsZh = pick.lang === "zh";
const labelZhBtn = {
  zh: sourceIsZh ? "中文原文" : "中文译文",
  en: sourceIsZh ? "Chinese original" : "Chinese 中译",
};
const labelEnBtn = {
  zh: sourceIsZh ? "英文译文" : "英文原文",
  en: sourceIsZh ? "English translation" : "English original",
};

// --- Structured data -------------------------------------------------------
// A pick is a human-reviewed, bilingual write-up of a source article, so
// TechArticle is the right type. `isBasedOn` credits the source; AI/answer
// engines read this graph to attribute and cite. BreadcrumbList gives Google
// the Home › Tag › Article trail for rich-result breadcrumbs.
const canonicalUrl = new URL(`/a/${pick.slug}`, Astro.site).toString();
const siteOrigin = new URL(Astro.site ?? "https://glean.smartcoder.ai").origin;
const publishedIso = pick.published_at ? pick.published_at.toISOString() : undefined;
const primaryTag = pick.tags[0];

const articleLd: Record<string, unknown> = {
  "@type": "TechArticle",
  headline: pick.title_en,
  alternativeHeadline: pick.title_zh,
  description: pick.summary_en,
  inLanguage: ["zh-CN", "en"],
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  ...(publishedIso ? { datePublished: publishedIso, dateModified: publishedIso } : {}),
  articleSection: pick.category,
  keywords: pick.tags.map((t) => t.name_en).join(", "),
  isBasedOn: pick.source_url,
  publisher: { "@id": `${siteOrigin}/#org` },
};

const breadcrumbLd = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${siteOrigin}/` },
    ...(primaryTag
      ? [{
          "@type": "ListItem",
          position: 2,
          name: primaryTag.name_en,
          item: `${siteOrigin}/tag/${primaryTag.slug}`,
        }]
      : []),
    { "@type": "ListItem", position: primaryTag ? 3 : 2, name: pick.title_en, item: canonicalUrl },
  ],
};
---
<Site
  title={`${pick.title_en} — Glean · 拾遗`}
  description={pick.summary_en}
  ogType="article"
  publishedTime={publishedIso}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <link rel="stylesheet" href="/article.css?v=art3" slot="head" />
  <link rel="stylesheet" href="/article.css?v=art3" />

  <div style="padding-top: 40px; padding-bottom: 64px">
    <div class="av2-layout">
      <aside class="av2-toc" aria-label="目录 / Contents">
        <div class="av2-toc__head">
          <Lang zh="目录" en="Contents" />
        </div>
        <ol class="av2-toc__list">
          {tocItems.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                data-toc-target={item.id}
                title={`${item.section} · ${item.labelZh}${item.labelEn ? ` / ${item.labelEn}` : ""}`}
              >
                <span class="sec-num">{item.section}</span>
                <span class="title">
                  <Lang zh={item.labelZh} en={item.labelEn} />
                </span>
                {item.count > 0 && <span class="count">{item.count}</span>}
              </a>
            </li>
          ))}
        </ol>
        {pick.annotations.length > 0 && (
          <div class="av2-toc__foot">
            <Lang>
              <Fragment slot="zh">{pick.annotations.length} 条评注</Fragment>
              <Fragment slot="en">{pick.annotations.length} notes</Fragment>
            </Lang>
          </div>
        )}
      </aside>

      <article class="av2">
        <header class="av2-head">
          <div class="av2-crumbs">
            {album ? (
              <>
                <a href={L("/album")}><Lang zh="专辑" en="Albums" /></a>
                <span class="sep">/</span>
                <a href={L(`/album/${album.slug}`)}><Lang zh={album.titleZh} en={album.titleEn} /></a>
              </>
            ) : (
              <>
                <a href={L("/daily")}><Lang zh="日刊" en="Daily" /></a>
                {publishedDate && (<><span class="sep">/</span><a href={L(`/daily/${publishedDate}`)}>{publishedDate}</a></>)}
              </>
            )}
            <span class="sep">/</span>
            <span>
              <Lang zh={pick.title_zh} en={pick.title_en} />
            </span>
          </div>

          <h1 class="av2-head__title">
            <Lang zh={pick.title_zh} en={pick.title_en} />
          </h1>

          <div class="av2-head__meta">
            <span>
              <span class="k"><Lang zh="原文" en="Source" /></span>
              <a class="v" href={pick.source_url} rel="noopener">{pick.source_host}</a>
            </span>
            <span>
              <span class="k"><Lang zh="收录" en="Glean’d" /></span>
              <span class="v">{publishedDate} {publishedTime}</span>
            </span>
            <span>
              <span class="k"><Lang zh="阅读" en="Read" /></span>
              <span class="v">{pick.read_minutes} min</span>
            </span>
          </div>
        </header>

        {(pick.summary_zh || pick.summary_en || pick.editor_note_zh || pick.editor_note_en) && (
          <section class="av2-decision" aria-label="AI summary">
            <div class="av2-decision__label">
              <Lang zh="AI 解读" en="AI summary" />
            </div>
            {(pick.summary_zh || pick.summary_en) && (
              <div class="av2-decision__tldr">
                <p class="av2-decision__tldr-text">
                  <Lang zh={pick.summary_zh} en={pick.summary_en} />
                </p>
              </div>
            )}
            {(pick.editor_note_zh || pick.editor_note_en) && (
              <p>
                <span class="marker"><Lang zh="编辑说" en="Editor" /></span>
                <Lang zh={pick.editor_note_zh ?? undefined} en={pick.editor_note_en ?? undefined} />
              </p>
            )}
            <div class="av2-decision__pills">
              <span class="av2-decision__pill av2-decision__pill--depth">
                <Lang>
                  <Fragment slot="zh">原文 {pick.read_minutes} 分钟</Fragment>
                  <Fragment slot="en">Original · {pick.read_minutes} min</Fragment>
                </Lang>
              </span>
            </div>
          </section>
        )}

        <div class="av2-modebar" role="tablist" aria-label="Reading mode">
          <div class="av2-modebar__group">
            <button class="av2-modebar__btn" data-mode-set="trans" role="tab">
              <Lang zh={labelZhBtn.zh} en={labelZhBtn.en} />
            </button>
            <button class="av2-modebar__btn" data-mode-set="orig" role="tab">
              <Lang zh={labelEnBtn.zh} en={labelEnBtn.en} />
            </button>
            <button class="av2-modebar__btn is-active" data-mode-set="parallel" role="tab" aria-selected="true">
              <Lang zh="对照" en="Parallel" />
            </button>
          </div>
          <a class="av2-modebar__source" href={pick.source_url} rel="noopener">
            <Lang>
              <Fragment slot="zh">原文 {pick.source_host} ↗</Fragment>
              <Fragment slot="en">{pick.source_host} ↗</Fragment>
            </Lang>
          </a>
        </div>

        <div class="av2-body" data-mode="parallel" data-pick-id={pick.id}>
          {pick.sections.map((s, i) => {
            const anchorId = s.anchor_id ?? "";
            const noteCount = anchorId ? annotationsByAnchor.get(anchorId) ?? 0 : 0;
            return (
              <div class="av2-row" data-pair={i + 1} id={`row-${i + 1}`}>
                {noteCount > 0 ? (
                  <button type="button" class="av2-row__num is-button" data-open-anchor={anchorId} aria-label={`§ ${i + 1} · ${noteCount} notes`}>
                    § {i + 1} <span class="anchor-count">{noteCount}</span>
                  </button>
                ) : (
                  <span class="av2-row__num">§ {i + 1}</span>
                )}
                <div class="av2-orig av2-prose" lang="en" data-sec={i + 1} data-lang="en" set:html={renderMarkdown(s.body_en)} />
                <div class="av2-trans av2-prose" lang="zh" data-sec={i + 1} data-lang="zh" set:html={renderMarkdown(s.body_zh)} />
              </div>
            );
          })}
        </div>
        <script>
          import "../../scripts/reading-notes";
        </script>

        <div style="margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--c-hairline)">
          <a href={pick.source_url} class="btn btn-primary" rel="noopener">
            <Lang zh="打开原文 ↗" en="Open source ↗" />
          </a>
        </div>

        {/* Footer extras — used to live in a sticky right rail; moved below
            the body so the bilingual columns get the full reading width. */}
        <section class="av2-footer" aria-label="More">
          <div class="av2-footer__grid">
            <div class="av2-footer__col av2-footer__col--side">
              <div class="av2-footer__sec">
                <div class="av2-footer__label">
                  <Lang zh="标签" en="Tags" />
                </div>
                <div class="aside-tags">
                  {pick.tags.map((t) => {
                    const b = categoryBadge(t.family);
                    return (
                    <a href={L(`/tag/${t.slug}`)} class={`badge ${b.className}`} style={b.style}>
                      <Lang zh={t.name_zh} en={t.name_en} />
                    </a>
                  )})}
                </div>
              </div>

              {pick.next_hints.length > 0 && (
                <div class="av2-footer__sec">
                  <div class="av2-footer__label">
                    <Lang zh="读完这条，下一步" en="What to read next" />
                  </div>
                  <div class="row" style="gap: 6px; flex-wrap: wrap">
                    {pick.next_hints.map((h) => (
                      <a class="badge" href={L(`/tag/${h.toLowerCase().replace(/\s+/g, "-")}`)} style="text-decoration: none">→ {h}</a>
                    ))}
                  </div>
                </div>
              )}
            </div>

            {pick.glossary.length > 0 && (
              <div class="av2-footer__col av2-footer__col--main">
                <div class="av2-footer__sec">
                  <div class="av2-footer__label">
                    <Lang zh="术语" en="Glossary" />
                  </div>
                  <dl class="av2-glossary">
                    {pick.glossary.map((g) => (
                      <div class="av2-glossary__row">
                        <dt class="av2-glossary__term">
                          {g.en} · <span class="text-muted">{g.zh}</span>
                        </dt>
                        <dd class="av2-glossary__def">{g.meaning}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              </div>
            )}
          </div>

          {pick.annotations.length > 0 && (
            <div class="av2-footer__sec av2-footer__sec--notes">
              <div class="av2-footer__label">
                <Lang zh="编辑注" en="Notes" />
              </div>
              <ol class="av2-notes">
                {pick.annotations.map((a) => (
                  <li>
                    <div class="av2-notes__anchor">{a.anchor}</div>
                    <p class="av2-notes__body">
                      <Lang zh={a.body_zh} en={a.body_en} />
                    </p>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </section>

        {(prev || next) && (
        <nav class="pn-nav" aria-label="上一篇 / 下一篇 · prev / next">
          {prev ? (
            <a class="pn-card pn-card--prev" href={L(`/a/${prev.slug}`)}>
              <span class="pn-card__dir">
                ← <Lang>
                  <Fragment slot="zh">上一条 · {neighborSuffixZh(prev.daily_date)}</Fragment>
                  <Fragment slot="en">Previous · {neighborSuffixEn(prev.daily_date)}</Fragment>
                </Lang>
              </span>
              <span class="pn-card__title">
                <Lang zh={prev.title_zh} en={prev.title_en} />
              </span>
            </a>
          ) : <span class="pn-card pn-card--empty" aria-hidden="true"></span>}
          {next ? (
            <a class="pn-card pn-card--next" href={L(`/a/${next.slug}`)}>
              <span class="pn-card__dir">
                <Lang>
                  <Fragment slot="zh">下一条 · {neighborSuffixZh(next.daily_date)}</Fragment>
                  <Fragment slot="en">Next · {neighborSuffixEn(next.daily_date)}</Fragment>
                </Lang> →
              </span>
              <span class="pn-card__title">
                <Lang zh={next.title_zh} en={next.title_en} />
              </span>
            </a>
          ) : <span class="pn-card pn-card--empty" aria-hidden="true"></span>}
        </nav>
        )}
      </article>
    </div>
  </div>

  <script is:inline>
    (function () {
      const body = document.querySelector(".av2-body");
      const buttons = document.querySelectorAll(".av2-modebar__btn");
      if (!body || !buttons.length) return;
      const apply = (mode) => {
        body.setAttribute("data-mode", mode);
        buttons.forEach((b) => {
          const active = b.getAttribute("data-mode-set") === mode;
          b.classList.toggle("is-active", active);
          b.setAttribute("aria-selected", active ? "true" : "false");
        });
        try { localStorage.setItem("glean.readMode", mode); } catch (_) {}
      };
      buttons.forEach((b) =>
        b.addEventListener("click", () => apply(b.getAttribute("data-mode-set")))
      );
      try {
        const saved = localStorage.getItem("glean.readMode");
        if (saved && ["orig", "trans", "parallel"].includes(saved)) apply(saved);
      } catch (_) {}
    })();
  </script>
</Site>
